<%- include('partials/header', { bare: true }) %>
<div class="auth-wrap">
  <div class="card auth-card wide">
    <div class="auth-brand">
      <span class="brand-mark"><%- include('partials/logo') %></span>
      <div><strong>Digitale Stundenzettel</strong><span><%= settings.company_name %></span></div>
    </div>
    <h1>Willkommen, <%= user.name %>!</h1>
    <p class="muted">Bitte legen Sie einmal ein eigenes Passwort fest<% if (user.role === 'employee') { %> und unterschreiben Sie unten. Ihre Unterschrift wird danach bei jedem Eintrag automatisch gesetzt, Sie müssen also nie wieder von Hand unterschreiben<% } %>.</p>
    <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/willkommen" class="stack" data-signature-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <label>Neues Passwort <span class="hint">(mind. 8 Zeichen)</span>
          <input type="password" name="passwort" autocomplete="new-password" minlength="8" required>
        </label>
        <label>Passwort wiederholen
          <input type="password" name="passwort2" autocomplete="new-password" minlength="8" required>
        </label>
      </div>
      <% if (user.role === 'employee') { %>
        <div>
          <label style="margin-bottom:6px">Ihre Unterschrift</label>
          <%- include('partials/signature-pad', { required: true }) %>
        </div>
      <% } else if (locals.employerSignature) { %>
        <div>
          <label style="margin-bottom:6px">Unterschrift des Arbeitgebers <span class="hint">(Sie steht dann auf allen Stundenzetteln und der Einsatzliste. Das geht auch später unter Einstellungen.)</span></label>
          <%- include('partials/signature-pad', { required: false }) %>
        </div>
      <% } %>
      <button class="btn btn-primary btn-block" type="submit">Speichern und loslegen</button>
    </form>
  </div>
</div>
<%- include('partials/footer') %>
