<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
  <meta name="theme-color" content="#16302f" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b1211" media="(prefers-color-scheme: dark)">
  <title><%= title ? `${title} · ` : '' %>Stundenzettel<%= settings.company_name ? ` · ${settings.company_name}` : '' %></title>
  <script src="<%= asset('js/theme.js') %>"></script>
  <link rel="stylesheet" href="<%= asset('css/app.css') %>">
  <link rel="icon" href="/static/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
  <meta name="apple-mobile-web-app-title" content="Stundenzettel">
  <link rel="manifest" href="<%= asset('manifest.webmanifest') %>">
</head>
<body>
<%- include('launch') %>
<% if (user && !locals.bare) {
  const navActive = (href) => currentPath === href || (href !== '/admin' && currentPath.startsWith(href + '/')) ? 'active' : '';
%>
<header class="topbar">
  <a class="brand" href="/">
    <span class="brand-mark"><%- include('logo') %></span>
    <span>Stundenzettel<small><%= settings.company_name %></small></span>
  </a>
  <nav aria-label="Hauptnavigation">
    <a href="/" class="<%= /^\/(zettel|einsatzliste)/.test(currentPath) ? 'active' : '' %>">Heft</a>
    <% if (user.role === 'admin') { %>
      <a href="/admin/mitarbeiter" class="<%= navActive('/admin/mitarbeiter') %>">Mitarbeiter</a>
    <% } %>
    <% if (locals.isOwner) { %>
      <a href="/inhaber" class="<%= navActive('/inhaber') %>">Inhaber</a>
    <% } %>
    <a href="/einstellungen" class="<%= navActive('/einstellungen') %>">Einstellungen</a>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Hell/Dunkel umschalten" title="Hell/Dunkel umschalten"><span aria-hidden="true" data-theme-icon>◐</span></button>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit">Abmelden</button>
    </form>
  </nav>
</header>
<% } else { %>
<button type="button" class="theme-toggle theme-toggle-floating" data-theme-toggle aria-label="Hell/Dunkel umschalten" title="Hell/Dunkel umschalten"><span aria-hidden="true" data-theme-icon>◐</span></button>
<% } %>
<main class="<%= locals.bare ? '' : 'container' %>">
<% if (locals.dbIsTemporary && locals.isOwner && !locals.bare) { %><%- include('db-temporary') %><% } %>
<% if (flash && !locals.bare) { %>
  <div class="flash flash-<%= flash.type %>" role="status">
    <%= flash.message %>
    <% if (flash.details && flash.details.length) { %>
      <ul><% flash.details.forEach((d) => { %><li><%= d %></li><% }) %></ul>
    <% } %>
  </div>
<% } %>
