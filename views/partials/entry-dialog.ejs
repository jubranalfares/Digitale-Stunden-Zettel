<%#
  Erfassungsfenster: öffnet sich beim Antippen eines Tages (Stundenzettel oder Einsatzliste).
  Erwartet: dialog (Daten für das Skript), returnTo (Rücksprung nach dem Speichern).
%>
<dialog class="entry-dialog" id="entry-dialog" aria-labelledby="entry-dialog-title">
  <form method="post" data-entry-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="zurueck" value="<%= returnTo %>">
    <input type="hidden" name="datum" data-in="datum">
    <input type="hidden" name="pause" data-in="pause" value="0:00">
    <input type="hidden" name="kuerzel" data-in="kuerzel" value="">

    <div class="dlg-head">
      <div>
        <div class="dlg-who" data-out="name"></div>
        <h2 id="entry-dialog-title" data-out="day"></h2>
      </div>
      <button type="button" class="dlg-x" data-dialog-close aria-label="Schließen">✕</button>
    </div>

    <div class="dlg-body">
      <div class="flash flash-info small hidden" data-out="block"></div>

      <div class="dlg-recent hidden" data-out="recentWrap">
        <div class="dlg-label">Schnellauswahl</div>
        <div class="chips" data-out="recent"></div>
      </div>

      <div class="dlg-times">
        <label>Von <input type="time" name="beginn" data-in="beginn"></label>
        <span class="dlg-dash" aria-hidden="true">–</span>
        <label>Bis <input type="time" name="ende" data-in="ende"></label>
      </div>

      <div class="dlg-label">Pause</div>
      <div class="chips" data-chips="pause">
        <button type="button" data-value="0:00">keine</button>
        <button type="button" data-value="0:15">15 Min</button>
        <button type="button" data-value="0:30">30 Min</button>
        <button type="button" data-value="0:45">45 Min</button>
        <button type="button" data-value="1:00">1 Std</button>
        <select data-more="pause" aria-label="Längere Pause">
          <option value="">länger…</option>
          <% ['1:15', '1:30', '1:45', '2:00', '2:30', '3:00', '3:30', '4:00'].forEach((v) => { %><option value="<%= v %>"><%= v %> Std</option><% }) %>
        </select>
      </div>

      <div class="dlg-result" data-out="result">
        <span data-out="resultLabel">Stunden an diesem Tag</span>
        <strong data-out="duration">–</strong>
      </div>

      <div class="dlg-label">Kürzel <span class="muted">– nur wenn zutreffend</span></div>
      <div class="chips chips-codes" data-chips="kuerzel">
        <% Object.entries(CODES).forEach(([code, text]) => { %>
          <button type="button" data-value="<%= code %>"><strong><%= code %></strong> <%= text.replace('unbezahlter', 'unbez.').replace('Stundenweise', 'Std.-weise') %></button>
        <% }) %>
      </div>

      <label class="dlg-remark">Bemerkung <input name="bemerkung" data-in="bemerkung" maxlength="200" placeholder="optional"></label>

    </div>

    <div class="dlg-foot">
      <button type="submit" class="btn btn-danger hidden" data-delete formnovalidate data-confirm="Eintrag für diesen Tag wirklich löschen?">Löschen</button>
      <button type="submit" class="btn btn-primary" data-save>Speichern</button>
    </div>
  </form>
</dialog>
<script type="application/json" id="entry-data"><%- json(dialog) %></script>
