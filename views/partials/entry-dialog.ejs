<%#
  Eingabefenster für einen Tag: Beginn und Ende direkt eintippen (Stunde, Minute), speichern.
  Nach zwei Ziffern springt die Eingabe von selbst ins nächste Feld. Gesteuert von public/js/app.js.
%>
<%
  const timeBox = (field, label) => `
    <div class="time-box" data-box="${field}">
      <span class="tile-label">${label}</span>
      <div class="time-inputs">
        <label class="time-part">
          <input class="time-in" data-in="${field}-h" inputmode="numeric" pattern="[0-9]*" placeholder="--"
                 autocomplete="off" enterkeyhint="next" aria-label="${label} Stunde">
          <span>Stunde</span>
        </label>
        <span class="time-colon" aria-hidden="true">:</span>
        <label class="time-part">
          <input class="time-in" data-in="${field}-m" inputmode="numeric" pattern="[0-9]*" placeholder="--"
                 autocomplete="off" enterkeyhint="next" aria-label="${label} Minute">
          <span>Minute</span>
        </label>
      </div>
    </div>`;
%>
<dialog class="entry-dialog" data-entry-dialog aria-labelledby="entry-title">
  <form method="dialog" class="entry-form" data-entry-form novalidate>
    <header class="entry-head">
      <div>
        <h2 id="entry-title" data-entry-title tabindex="-1"></h2>
        <div class="entry-name" data-entry-name></div>
      </div>
      <button type="button" class="entry-close" data-entry-close aria-label="Schließen">✕</button>
    </header>

    <div class="entry-body">
      <div class="time-tiles">
        <%- timeBox('start', 'Beginn') %>
        <span class="tile-sep" aria-hidden="true">bis</span>
        <%- timeBox('end', 'Ende') %>
      </div>
    </div>

    <footer class="entry-foot">
      <div class="entry-total" data-entry-total aria-live="polite"></div>
      <div class="entry-error" data-entry-error role="alert" hidden></div>
      <div class="entry-actions">
        <button type="button" class="btn btn-ghost btn-delete" data-entry-delete>Löschen</button>
        <button type="submit" class="btn btn-primary" data-entry-save>Speichern</button>
      </div>
    </footer>
  </form>
</dialog>
