<%#
  Eingabefenster für einen Tag: Beginn und Ende wählen, speichern.
  Stunden und Minuten stehen auf einem Bildschirm. Gesteuert von public/js/app.js.
%>
<dialog class="entry-dialog" data-entry-dialog aria-labelledby="entry-title">
  <form method="dialog" class="entry-form" data-entry-form novalidate>
    <div class="sheet-grip" aria-hidden="true"></div>
    <header class="entry-head">
      <div>
        <h2 id="entry-title" data-entry-title tabindex="-1"></h2>
        <div class="entry-name" data-entry-name></div>
      </div>
      <button type="button" class="entry-close" data-entry-close aria-label="Schließen">✕</button>
    </header>

    <div class="entry-body">
      <div class="time-tiles">
        <button type="button" class="time-tile" data-tile="start">
          <span class="tile-label">Beginn</span>
          <span class="tile-value" data-tile-value="start">--:--</span>
        </button>
        <span class="tile-sep" aria-hidden="true">bis</span>
        <button type="button" class="time-tile" data-tile="end">
          <span class="tile-label">Ende</span>
          <span class="tile-value" data-tile-value="end">--:--</span>
        </button>
      </div>

      <div class="picker" data-picker>
        <p class="picker-head" data-picker-head></p>
        <div class="picker-grid" role="group" aria-label="Stunde">
          <% for (let h = 0; h < 24; h++) { %><button type="button" data-hour="<%= h %>"><%= h %></button><% } %>
        </div>
        <div class="picker-minutes" role="group" aria-label="Minuten" data-minutes>
          <% [0, 15, 30, 45].forEach((m) => { %><button type="button" data-minute="<%= m %>">:<%= String(m).padStart(2, '0') %></button><% }) %>
        </div>
      </div>
    </div>

    <footer class="entry-foot">
      <div class="entry-total" data-entry-total aria-live="polite"></div>
      <div class="entry-error" data-entry-error role="alert" hidden></div>
      <div class="entry-actions">
        <button type="button" class="btn btn-ghost btn-delete" data-entry-delete>Löschen</button>
        <button type="submit" class="btn btn-primary" data-entry-save>Speichern</button>
      </div>
    </footer>
  </form>
</dialog>
