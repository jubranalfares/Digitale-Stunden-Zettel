<%# Startbildschirm beim Öffnen der App vom Home-Bildschirm (nur beim ersten Aufruf; siehe theme.js). %>
<div class="launch" aria-hidden="true">
  <div class="launch-inner">
    <div class="launch-logo">
      <span class="launch-ring"></span><span class="launch-ring two"></span>
      <svg viewBox="0 0 64 64">
        <defs>
          <linearGradient id="launch-bg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#2bb3aa"/><stop offset="1" stop-color="#0d5e60"/>
          </linearGradient>
        </defs>
        <rect class="l-tile" width="64" height="64" rx="15" fill="url(#launch-bg)"/>
        <g class="l-sheet">
          <path d="M19 11h19l11 11v29a3 3 0 0 1-3 3H19a3 3 0 0 1-3-3V14a3 3 0 0 1 3-3z" fill="#fff"/>
          <path d="M38 11v8a3 3 0 0 0 3 3h8z" fill="#bfe6e2"/>
        </g>
        <g stroke="#9fc2be" stroke-width="2.4" stroke-linecap="round">
          <path class="l-line l1" d="M22 28h18"/><path class="l-line l2" d="M22 34h18"/><path class="l-line l3" d="M22 40h10"/>
        </g>
        <g class="l-clock">
          <circle cx="44" cy="45" r="10" fill="#0d5e60" stroke="#fff" stroke-width="2.5"/>
          <path class="l-hand-h" d="M44 45v-4" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/>
          <path class="l-hand-m" d="M44 45v-6.5" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
          <circle cx="44" cy="45" r="1.4" fill="#fff"/>
        </g>
      </svg>
    </div>
    <div class="launch-title">Stundenzettel</div>
    <div class="launch-sub"><%= settings.company_name || 'Das digitale Heft' %></div>
    <div class="launch-bar"><span></span></div>
  </div>
</div>
