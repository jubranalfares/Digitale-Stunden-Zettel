<%- include('partials/header', { bare: true }) %>
<div class="auth-wrap">
  <div class="card auth-card">
    <div class="auth-brand">
      <img class="brand-mark" src="/static/icon.svg" alt="" width="34" height="34">
      <div><strong>Digitale Stundenzettel</strong><span><%= settings.company_name %></span></div>
    </div>
    <h1>Anmelden</h1>
    <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login" class="stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Benutzername
        <input name="benutzername" value="<%= username %>" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required autofocus>
      </label>
      <label>Passwort
        <input type="password" name="passwort" autocomplete="current-password" required>
      </label>
      <button class="btn btn-primary btn-block" type="submit">Anmelden</button>
    </form>
    <p class="muted small" style="margin-top:16px">Passwort vergessen? Der Chef kann Ihnen ein neues Startpasswort geben.</p>

  </div>
</div>
<%- include('partials/footer') %>
