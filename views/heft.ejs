<%- include('partials/header') %>
<div class="heft" data-heft data-csrf="<%= csrfToken %>">
  <div class="heft-top">
    <%- include('partials/month-nav', { navBase, ym, isCurrentMonth }) %>
    <% if (isAdmin) { %>
      <a class="btn btn-primary" href="/pdf?monat=<%= monthKey(ym) %>" target="_blank" rel="noopener"
         data-pdf data-pdf-file="<%= pdfFileName %>" data-pdf-title="Stundenzettel <%= monthLabel(ym) %>">PDF für Steuerberater</a>
    <% } %>
  </div>

  <% if (signatureMissing) { %>
    <div class="flash flash-warning banner">
      <span>Ihre Unterschrift fehlt noch. Einmal unterschreiben reicht, danach setzt die App sie von selbst.</span>
      <a class="btn btn-small" href="/einstellungen#unterschrift">Unterschreiben</a>
    </div>
  <% } %>
  <% if (employerSignatureMissing) { %>
    <div class="flash flash-warning banner">
      <span>Ihre Unterschrift als Chef fehlt noch.</span>
      <a class="btn btn-small" href="/einstellungen#unterschrift">Unterschreiben</a>
    </div>
  <% } %>

  <nav class="heft-tabs" aria-label="Register">
    <% tabs.forEach((t) => { %>
      <a href="<%= t.href %>" class="<%= t.key === tab ? 'active' : '' %>"><%= t.label %></a>
    <% }) %>
  </nav>

  <% if (kind === 'sheet') { %>
    <p class="heft-hint">Tippen Sie auf einen Tag, um die Zeiten einzutragen.</p>
    <div class="paper-scroll" data-scroll>
      <%- include('partials/datev-paper', { sheet, interactive: true, editable }) %>
    </div>
  <% } else { %>
    <p class="heft-hint"><%= isAdmin ? 'Tippen Sie in der Spalte eines Mitarbeiters auf einen Tag, um Zeiten einzutragen.' : 'Tippen Sie in Ihrer Spalte auf einen Tag, um Ihre Zeiten einzutragen.' %></p>
    <% roster.pages.forEach((columns, pageIndex) => { %>
      <div class="paper-scroll roster-scroll" data-scroll>
        <%- include('partials/roster-paper', {
          roster, columns, pageIndex, viewer: user, editable, canEditColumn,
          linkBase: isAdmin ? '/zettel' : '',
        }) %>
      </div>
    <% }) %>
  <% } %>
</div>
<%- include('partials/entry-dialog') %>
<% if (isAdmin) { %><%- include('partials/pdf-dialog') %><% } %>
<div class="toast" data-toast role="status" aria-live="polite"></div>
<%- include('partials/footer') %>
