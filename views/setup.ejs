<%- include('partials/header', { bare: true }) %>
<div class="auth-wrap">
  <div class="card auth-card wide">
    <div class="auth-brand">
      <span class="brand-mark"><%- include('partials/logo') %></span>
      <div><strong>Digitale Stundenzettel</strong><span>Ersteinrichtung</span></div>
    </div>
    <h1>Willkommen! Zuerst brauchen wir Ihren Zugang.</h1>
    <p class="muted">Wer die App einrichtet, wird <strong>Inhaber</strong>. Als Inhaber sehen Sie alle Stundenzettel, legen die Zugänge für Chefs und Mitarbeiter an und laden das PDF für den Steuerberater herunter.</p>
    <% if (locals.dbIsTemporary) { %><%- include('partials/db-temporary') %><% } else if (locals.dbInfo && dbInfo.host !== 'lokale Datei') { %>
      <div class="flash flash-success">Die Datenbank ist richtig verbunden (<code><%= dbInfo.host.split('.')[0] %></code>). Ihre Daten bleiben auch nach Updates erhalten.</div>
    <% } %>
    <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/setup" class="form-grid">
      <label class="full">Name des Betriebs <span class="hint">(erscheint als „Firma“ auf den Formularen)</span>
        <input name="firma" value="<%= values.company || '' %>" placeholder="z. B. Eiscafé Taormina" required>
      </label>
      <label>Ihr Name
        <input name="name" value="<%= values.name || '' %>" autocomplete="name" required>
      </label>
      <label>Benutzername
        <input name="benutzername" value="<%= values.username || '' %>" autocomplete="username" autocapitalize="none" required>
      </label>
      <label>Passwort <span class="hint">(mind. 8 Zeichen)</span>
        <input type="password" name="passwort" autocomplete="new-password" minlength="8" required>
      </label>
      <label>Passwort wiederholen
        <input type="password" name="passwort2" autocomplete="new-password" minlength="8" required>
      </label>
      <div class="full form-actions">
        <button class="btn btn-primary" type="submit">Einrichten</button>
      </div>
    </form>

    <% if (locals.dbInfo) { %>
      <details class="tech-info">
        <summary>Technische Angaben (für den Entwickler)</summary>
        <dl class="facts small">
          <dt>Datenbank</dt><dd><code><%= dbInfo.host %></code><% if (dbInfo.variable) { %> aus <code><%= dbInfo.variable %></code><% } %></dd>
          <% if (dbInfo.version) { %><dt>Version</dt><dd><code><%= dbInfo.version %></code></dd><% } %>
          <dt>Variablen</dt>
          <dd>
            <% if (!dbInfo.variables.length) { %>keine<% } %>
            <% dbInfo.variables.forEach((v) => { %><div><code><%= v.name %></code><% if (v.host) { %>: <%= v.host %><% } %></div><% }) %>
          </dd>
        </dl>
      </details>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
