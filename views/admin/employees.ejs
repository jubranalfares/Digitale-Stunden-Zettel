<%- include('../partials/header') %>
<div class="page-head"><h1>Mitarbeiter</h1></div>

<div class="card">
  <div class="table-wrap">
    <table class="data-table">
      <thead><tr><th>Name</th><th>Benutzername</th><th>Unterschrift</th><th class="actions"></th></tr></thead>
      <tbody>
        <% users.forEach((u) => { %>
          <tr class="<%= u.active ? '' : 'inactive' %>">
            <td>
              <strong><%= u.name %></strong>
              <% if (u.role === 'admin') { %> <span class="chip chip-accent">Chef</span><% } %>
              <% if (!u.active) { %> <span class="chip">inaktiv</span><% } %>
            </td>
            <td><%= u.username %></td>
            <td><% if (u.role === 'admin') { %>–<% } else if (u.signature_id) { %><span class="chip chip-ok">✓</span><% } else { %><span class="chip chip-warn">noch nicht angemeldet</span><% } %></td>
            <td class="actions"><a class="btn btn-small" href="/admin/mitarbeiter/<%= u.id %>">Bearbeiten</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card" id="neu">
  <h2>Neuer Mitarbeiter</h2>
  <% if (error) { %><div class="flash flash-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/admin/mitarbeiter" class="form-grid">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Vor- und Nachname <input name="name" value="<%= values.name || '' %>" required></label>
    <label>Benutzername <input name="benutzername" value="<%= values.username || '' %>" autocapitalize="none" autocomplete="off" required pattern="[A-Za-z0-9._@\-]{3,40}"></label>
    <label>Startpasswort <input name="passwort" value="<%= suggestedPassword %>" minlength="8" required autocomplete="off"></label>
    <div class="form-actions" style="align-self:end;margin:0"><button class="btn btn-primary" type="submit">Anlegen</button></div>
  </form>
  <p class="muted small" style="margin:12px 0 0">Bei der ersten Anmeldung vergibt der Mitarbeiter ein eigenes Passwort und unterschreibt einmal.</p>
</div>
<%- include('../partials/footer') %>
