<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1><%= roster.title %></h1>
    <div class="sub">Alle Mitarbeiter auf einem Blatt – Stunden pro Tag mit Unterschrift</div>
  </div>
  <div class="spacer"></div>
  <%- include('../partials/month-nav', { navBase: '/admin/einsatzliste', ym, isCurrentMonth }) %>
  <a class="btn btn-primary" href="/admin/einsatzliste/pdf?monat=<%= roster.month %>" target="_blank" rel="noopener">PDF öffnen</a>
</div>
<% if (!roster.employees.length) { %>
  <div class="flash flash-info">Für diesen Monat stehen noch keine Mitarbeiter auf der Einsatzliste.</div>
<% } %>
<% roster.pages.forEach((columns, pageIndex) => { %>
  <%- include('../partials/roster-paper', { roster, columns, pageIndex, linkBase: '/admin/zettel' }) %>
<% }) %>
<%- include('../partials/footer') %>
