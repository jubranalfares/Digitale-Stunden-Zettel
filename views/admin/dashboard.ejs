<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1>Übersicht</h1>
    <div class="sub">Alle Stundenzettel im <%= monthLabel(ym) %></div>
  </div>
  <div class="spacer"></div>
  <%- include('../partials/month-nav', { navBase: '/admin', ym, isCurrentMonth }) %>
</div>

<% if (!employerSignatureSet) { %>
  <div class="flash flash-warning banner">
    <span>Ihre Unterschrift als Arbeitgeber ist noch nicht hinterlegt. Sie wird danach automatisch auf allen Zetteln eingesetzt.</span>
    <a class="btn btn-small" href="/einstellungen#unterschrift">Jetzt hinterlegen</a>
  </div>
<% } %>

<div class="stats">
  <div class="stat"><span>Mitarbeiter mit Einträgen</span><strong><%= exportable %> / <%= rows.length %></strong></div>
  <div class="stat"><span>Stunden gesamt</span><strong><%= formatDuration(totalMinutes) %></strong></div>
  <div class="stat"><span>Status</span><strong style="font-size:1.05rem">
    <% if (lock) { %><span class="chip chip-accent">🔒 Abgeschlossen am <%= formatDateDE(lock.locked_at.slice(0, 10)) %></span><% } else { %><span class="chip chip-ok">Offen</span><% } %>
  </strong></div>
</div>

<div class="card export-card">
  <div>
    <h2>Für den Steuerberater</h2>
    <p class="muted small" style="margin:0">Alle Stundenzettel und die Einsatzliste – fertig unterschrieben als PDF. Mitarbeiter ohne Einträge im Monat werden nicht exportiert.</p>
  </div>
  <div class="btn-row">
    <a class="btn btn-primary <%= exportable ? '' : 'disabled' %>" href="/admin/export.zip?monat=<%= month %>">ZIP (eine PDF je Mitarbeiter)</a>
    <a class="btn <%= exportable ? '' : 'disabled' %>" href="/admin/export.pdf?monat=<%= month %>">Alles in einer PDF</a>
    <a class="btn" href="/admin/einsatzliste?monat=<%= month %>">Einsatzliste ansehen</a>
  </div>
</div>

<div class="card">
  <div class="banner" style="margin-bottom:10px">
    <h2 style="margin:0">Stundenzettel</h2>
    <form method="post" action="/admin/monat/<%= lock ? 'oeffnen' : 'abschliessen' %>" style="margin-left:auto">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="monat" value="<%= month %>">
      <% if (lock) { %>
        <button class="btn btn-small" type="submit" data-confirm="Monat wieder zur Bearbeitung freigeben?">Monat wieder öffnen</button>
      <% } else { %>
        <button class="btn btn-small" type="submit" data-confirm="Monat abschließen? Danach können Mitarbeiter keine Zeiten mehr in diesem Monat ändern.">🔒 Monat abschließen</button>
      <% } %>
    </form>
  </div>
  <% if (!rows.length) { %>
    <p class="muted">Noch keine Mitarbeiter angelegt. <a href="/admin/mitarbeiter">Jetzt Mitarbeiter anlegen →</a></p>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>Mitarbeiter</th>
            <th class="hide-mobile">Pers.-Nr.</th>
            <th class="num">Tage</th>
            <th class="num">Stunden</th>
            <th class="hide-mobile">Zuletzt erfasst</th>
            <th>Unterschrift</th>
            <th class="actions"></th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach((r) => { %>
            <tr class="<%= r.user.active ? '' : 'inactive' %>">
              <td><a href="/admin/zettel/<%= r.user.id %>?monat=<%= month %>"><strong><%= r.user.name %></strong></a><% if (!r.user.active) { %> <span class="chip">inaktiv</span><% } %></td>
              <td class="hide-mobile"><%= r.user.personnel_no || '–' %></td>
              <td class="num"><%= r.days %></td>
              <td class="num"><%= r.minutes ? formatDuration(r.minutes) : '–' %></td>
              <td class="hide-mobile"><%= r.lastRecorded ? formatDateDE(r.lastRecorded) : '–' %></td>
              <td>
                <% if (!r.hasSignature) { %><span class="chip chip-danger">fehlt</span>
                <% } else if (!r.days) { %><span class="chip">keine Einträge</span>
                <% } else if (r.unsignedByEmployee) { %><span class="chip chip-warn"><%= r.unsignedByEmployee %>× AG</span>
                <% } else { %><span class="chip chip-ok">✓ unterschrieben</span><% } %>
              </td>
              <td class="actions">
                <a class="btn btn-small" href="/admin/zettel/<%= r.user.id %>?monat=<%= month %>">Öffnen</a>
                <a class="btn btn-small hide-mobile <%= r.days ? '' : 'disabled' %>" href="/admin/zettel/<%= r.user.id %>/pdf?monat=<%= month %>" target="_blank" rel="noopener">PDF</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr><td>Summe</td><td class="hide-mobile"></td><td class="num"><%= rows.reduce((s, r) => s + r.days, 0) %></td><td class="num"><%= formatDuration(totalMinutes) %></td><td class="hide-mobile"></td><td></td><td></td></tr>
        </tfoot>
      </table>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
