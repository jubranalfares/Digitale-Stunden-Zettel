<%- include('partials/header') %>
<%
  const isAdmin = user.role === 'admin';
  const listed = sheet.rows.filter((r) => r.entry);
  const canEnter = !isAdmin ? !!signature : true;
%>
<div class="page-head">
  <div>
    <h1><%= isAdmin ? employee.name : 'Mein Stundenzettel' %></h1>
    <div class="sub">
      <% if (isAdmin) { %><a href="/admin?monat=<%= sheet.month %>">← Übersicht</a> · <% } %>
      Monatssumme <strong><%= sheet.total %> Std.</strong> <span class="muted">(<%= sheet.totalDecimal %>)</span>
    </div>
  </div>
  <div class="spacer"></div>
  <%- include('partials/month-nav', { navBase: base, ym, isCurrentMonth }) %>
  <a class="btn" href="<%= base %>/pdf?monat=<%= sheet.month %>" target="_blank" rel="noopener">PDF</a>
</div>

<% if (sheet.locked) { %>
  <div class="flash flash-info">🔒 <%= sheet.monthLabel %> ist abgeschlossen<%= isAdmin ? ' – zum Ändern in der Übersicht wieder freigeben' : '' %>.</div>
<% } %>
<% if (!isAdmin && !signature) { %>
  <div class="flash flash-warning banner">
    <span>Sie haben noch keine Unterschrift hinterlegt. Ohne Unterschrift können keine Zeiten gespeichert werden.</span>
    <a class="btn btn-small" href="/einstellungen#unterschrift">Jetzt unterschreiben</a>
  </div>
<% } %>
<% if (isAdmin && !employerSignatureSet) { %>
  <div class="flash flash-warning banner">
    <span>Die Unterschrift des Arbeitgebers ist noch nicht hinterlegt.</span>
    <a class="btn btn-small" href="/einstellungen#unterschrift">Jetzt hinterlegen</a>
  </div>
<% } %>

<div class="quick-bar">
  <button type="button" class="btn btn-primary btn-big" data-open-entry data-user="<%= employee.id %>" data-date="<%= quickDate %>" <%= sheet.locked || !canEnter ? 'disabled' : '' %>>
    ＋ <%= isCurrentMonth ? 'Heute erfassen' : `${formatDateDE(quickDate).slice(0, 6)} erfassen` %>
  </button>
  <span class="muted small">oder einen Tag im Formular antippen<% if (!isAdmin && signature) { %> · Ihre Unterschrift wird automatisch gesetzt<% } %></span>
</div>

<div class="card mobile-only" style="margin-bottom:16px">
  <h2>Einträge im <%= sheet.monthLabel %></h2>
  <% if (!listed.length) { %>
    <p class="muted small" style="margin:0">Noch keine Einträge in diesem Monat.</p>
  <% } else { %>
    <table class="entry-list">
      <thead><tr><th>Tag</th><th>von–bis</th><th>Pause</th><th class="right">Std.</th></tr></thead>
      <tbody>
        <% listed.forEach((r) => { %>
          <tr data-open-entry data-user="<%= employee.id %>" data-date="<%= r.date %>">
            <td class="nowrap"><%= WEEKDAYS_SHORT[r.weekday] %> <%= String(r.day).padStart(2, '0') %>.</td>
            <td class="num"><%= r.start ? `${r.start}–${r.end}` : '' %> <% if (r.code) { %><span class="chip"><%= r.code %></span><% } %></td>
            <td class="num"><%= r.breakTime %></td>
            <td class="num right"><strong><%= r.duration %></strong></td>
          </tr>
        <% }) %>
      </tbody>
      <tfoot><tr><td colspan="3">Monatssumme</td><td class="num right"><%= sheet.total %></td></tr></tfoot>
    </table>
  <% } %>
</div>

<div class="paper-scroll">
  <%- include('partials/datev-paper', { sheet, interactive: true, editUser: employee.id, today }) %>
</div>

<% if (isAdmin && auditRows.length) { %>
  <div class="card" style="margin-top:20px">
    <details class="audit">
      <summary>Änderungsprotokoll (<%= auditRows.length %>)</summary>
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>Zeitpunkt</th><th>Tag</th><th>Aktion</th><th>Durch</th><th>Details</th></tr></thead>
          <tbody>
            <% auditRows.forEach((a) => { %>
              <tr><td class="nowrap"><%= a.when %></td><td class="nowrap"><%= a.day %></td><td><%= a.action %></td><td><%= a.actor %></td><td><%= a.details %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </details>
  </div>
<% } %>

<%- include('partials/entry-dialog', { dialog, returnTo }) %>
<%- include('partials/footer') %>
