# Port der Anwendung
PORT=3000
# Ordner für die Datenbank (stundenzettel.db)
DATA_DIR=data
# Zeitzone für "heute" und "aufgezeichnet am"
APP_TIMEZONE=Europe/Berlin
# Hinter einem HTTPS-Proxy (Caddy, Nginx, Render, Railway …) auf 1 setzen
TRUST_PROXY=
# Erzwingt sichere Cookies (true/false). Leer = automatisch.
COOKIE_SECURE=
